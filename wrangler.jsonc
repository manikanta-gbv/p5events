{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p5events",
  // Not a secret — it is an account identifier, visible in every dashboard
  // URL, and grants nothing on its own. The API token is the credential.
  // Keeping it here means CI needs one secret instead of two.
  "account_id": "f8c97edc15df9ff338c60ead975ba657",
  "compatibility_date": "2026-09-26",

  // This site is a static export (next.config.mjs sets output: 'export'), so
  // there is no server to run — only the files in out/.
  //
  // Without this file, `wrangler deploy` auto-detects Next.js, assumes
  // server-side rendering, and installs the OpenNext adapter. That adapter
  // looks for .next/standalone/, which a static export never produces, and
  // the deploy fails with ENOENT on pages-manifest.json.
  //
  // Declaring assets here stops the auto-configuration and serves out/
  // directly from Cloudflare's edge.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
