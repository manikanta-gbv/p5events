{
  "name": "p5-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run images && next build",
    "start": "next start",
    "lint": "next lint",
    "images": "node scripts/generate-image-variants.mjs",
    "typecheck": "tsc --noEmit",
    "placeholders": "grep -rnoE '\\[[^]\"]+\\]' content/ || echo 'No placeholders left.'",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "login": "wrangler login",
    "cms-auth:deploy": "wrangler deploy --config cms-auth/wrangler.jsonc",
    "cms-auth:secrets": "wrangler secret put GITHUB_CLIENT_ID --config cms-auth/wrangler.jsonc && wrangler secret put GITHUB_CLIENT_SECRET --config cms-auth/wrangler.jsonc"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.2",
    "wrangler": "^4.86.0"
  }
}
